public class App {
    public static void main(String[] args) throws Exception {
    for(int i = 0;i<5;i++){
        System.out.println(i);
    }
    for (int i = 10; i < 21; i++){
        System.out.println(i);
    }
    for (int i = 0; i < 21; i++){
        if( i == 5 || i == 16 || i == 20){
         System.out.println(i);   
